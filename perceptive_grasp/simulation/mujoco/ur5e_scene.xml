<mujoco model="perceptive_grasp_ur5e">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast" solver="Newton"
          gravity="0 0 -9.81" cone="elliptic" iterations="80"/>

  <statistic center="0.45 0 0.25" extent="1.3"/>
  <visual>
    <global azimuth="135" elevation="-32" offwidth="1280"
            offheight="720"/>
    <headlight ambient="0.25 0.25 0.25" diffuse="0.7 0.7 0.7"/>
  </visual>

  <default>
    <default class="object">
      <joint type="free" damping="0.50"/>
      <geom density="650" friction="1.3 0.03 0.02" condim="6"
            solref="0.006 1" solimp="0.9 0.98 0.002"/>
    </default>
  </default>

  <asset>
    <model name="ur5e_2f85"
           file="models/universal_robots_ur5e/ur5e_robotiq_2f85.xml"/>
    <mesh name="apple_visual" file="assets/fruit/Apple.STL"
          scale="0.001 0.001 0.001"/>
    <mesh name="banana_visual" file="assets/fruit/Banana.STL"
          scale="0.001 0.001 0.001"/>
    <texture name="apple_texture" type="2d"
             file="assets/fruit/mesh/red-apple.png"/>
    <texture name="banana_texture" type="2d"
             file="assets/fruit/mesh/yellow-banana.png"/>
    <material name="apple_material" texture="apple_texture"
              texuniform="true" specular="0.15" shininess="0.25"/>
    <material name="banana_material" texture="banana_texture"
              texuniform="true" specular="0.08" shininess="0.15"/>
    <texture type="skybox" builtin="gradient" rgb1="0.45 0.60 0.76"
             rgb2="0.08 0.12 0.18" width="512" height="3072"/>
    <texture name="floor_tex" type="2d" builtin="checker" mark="edge"
             rgb1="0.18 0.27 0.36" rgb2="0.10 0.16 0.22"
             markrgb="0.7 0.7 0.7" width="300" height="300"/>
    <material name="floor_mat" texture="floor_tex" texuniform="true"
              texrepeat="8 8" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light pos="0.45 0 1.8" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" pos="0 0 -0.78" size="3 3 0.05"
          material="floor_mat"/>

    <body name="simple_table" pos="0.45 0 -0.05">
      <geom name="simple_table" type="box" size="0.80 0.60 0.05"
            mass="0" rgba="0.52 0.54 0.56 1"/>
      <geom type="box" pos="-0.68 -0.48 -0.39" size="0.04 0.04 0.34"
            mass="0" rgba="0.25 0.27 0.29 1"/>
      <geom type="box" pos="-0.68 0.48 -0.39" size="0.04 0.04 0.34"
            mass="0" rgba="0.25 0.27 0.29 1"/>
      <geom type="box" pos="0.68 -0.48 -0.39" size="0.04 0.04 0.34"
            mass="0" rgba="0.25 0.27 0.29 1"/>
      <geom type="box" pos="0.68 0.48 -0.39" size="0.04 0.04 0.34"
            mass="0" rgba="0.25 0.27 0.29 1"/>
    </body>

    <body name="zone_drop" pos="0.56 -0.40 0.008">
      <geom name="zone_drop" type="box" size="0.48 0.20 0.004"
            rgba="0.34 0.23 0.23 1" contype="0" conaffinity="0"/>
    </body>
    <body name="zone_pickup" pos="0.625 0.20 0.008">
      <geom name="zone_pickup" type="box" size="0.305 0.38 0.003"
            rgba="0.10 0.72 0.28 0.30" contype="0" conaffinity="0"/>
    </body>

    <camera name="realsense" pos="-0.020684 0.043910 0.300747"
            xyaxes="0.0414168 -0.9990285 -0.0150584
                    0.4946335 0.0074065 0.8690701" fovy="48"/>

    <body name="Apple" pos="0.56 0.27 0.038">
      <joint name="Apple_joint" type="free" damping="0.50"/>
      <geom name="Apple" type="mesh" mesh="apple_visual"
            material="apple_material" pos="-0.030884 0.034925 -0.044633"
            quat="0.707107 0.707107 0 0"
            contype="0" conaffinity="0" mass="0" group="2"/>
      <geom class="object" name="Apple_collision" type="sphere"
            size="0.038" rgba="0.86 0.05 0.04 0"/>
    </body>

    <body name="Banana" pos="0.56 0.08 0.028" euler="0 0 1.5708">
      <joint name="Banana_joint" type="free" damping="0.50"/>
      <geom name="Banana" type="mesh" mesh="banana_visual"
            material="banana_material" pos="-0.104485 0.020806 0.028256"
            quat="0 1 0 0"
            contype="0" conaffinity="0" mass="0" group="2"/>
      <geom class="object" name="Banana_collision_left" type="capsule"
            fromto="-0.078 0.012 0 -0.026 0 0" size="0.026"
            rgba="0.96 0.78 0.04 0"/>
      <geom class="object" name="Banana_collision_center" type="capsule"
            fromto="-0.026 0 0 0.026 0 0" size="0.026"
            rgba="0.96 0.78 0.04 0"/>
      <geom class="object" name="Banana_collision_right" type="capsule"
            fromto="0.026 0 0 0.078 0.012 0" size="0.026"
            rgba="0.96 0.78 0.04 0"/>
    </body>

    <body name="Cup" pos="0.56 -0.12 0.090">
      <joint name="Cup_joint" type="free" damping="0.50"/>
      <geom class="object" name="Cup" type="cylinder" size="0.040 0.090"
            density="300" rgba="0.08 0.18 0.95 1"/>
      <geom class="object" type="cylinder" pos="0 0 -0.085"
            size="0.038 0.005" density="5000"
            rgba="0.08 0.18 0.95 0"/>
      <geom type="cylinder" pos="0 0 0.091" size="0.041 0.003"
            rgba="0.82 0.94 1 1" contype="0" conaffinity="0"
            mass="0" group="2"/>
      <geom type="cylinder" pos="0 0 0.095" size="0.032 0.002"
            rgba="0.03 0.10 0.16 1" contype="0" conaffinity="0"
            mass="0" group="2"/>
      <geom class="object" type="capsule"
            fromto="0.035 0 0.050 0.075 0 0.050" size="0.008"
            density="80" rgba="0.08 0.18 0.95 1"/>
      <geom class="object" type="capsule"
            fromto="0.075 0 0.050 0.075 0 -0.035" size="0.008"
            density="80" rgba="0.08 0.18 0.95 1"/>
      <geom class="object" type="capsule"
            fromto="0.075 0 -0.035 0.035 0 -0.035" size="0.008"
            density="80" rgba="0.08 0.18 0.95 1"/>
    </body>

    <body name="Box" pos="0.56 -0.24 0.030">
      <joint name="Box_joint" type="free" damping="0.50"/>
      <geom class="object" name="Box" type="box" size="0.030 0.030 0.030"
            rgba="0.95 0.05 0.72 1"/>
    </body>

    <body name="robot_mount" pos="0 0 0">
      <attach model="ur5e_2f85" body="base" prefix="robot_"/>
    </body>
  </worldbody>

  <contact>
    <exclude body1="simple_table" body2="robot_base"/>
  </contact>

  <equality>
    <weld name="grasp_weld" body1="robot_gripper_base_mount"
          body2="Banana" active="false" solref="0.01 1"
          solimp="0.95 0.99 0.001"/>
  </equality>
</mujoco>
